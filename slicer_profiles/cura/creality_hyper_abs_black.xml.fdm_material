<?xml version="1.0" encoding="UTF-8"?>
<!-- Creality Hyper Series ABS, Black, for the Voron 2.4r2 350 (Dragon HF, CW2).
     Spool label: 1.75 mm, 30-300 mm/s, nozzle 230-270 C, bed 80-100 C.
     Owner's starting point (2026-11-12): bed 80 C, part fan 50-70 %: 50 % on layers of
     20 s or more, ramping to 70 % as layer time falls to the 12 s minimum.
     Nozzle 230 / 235 first layer, flow 0.903 and retraction 0.5 @ 35 come from the
     calibrated grey Hyper ABS (creality_hyper_abs.xml.fdm_material); re-check flow for this
     spool.  Pressure advance 0.036 is not a Cura material field (see that file).
     Speeds (30-300 mm/s) belong to the Cura print profile, not to the material.
     Bed 80 C: PRINT_START picks its soak gate from BED (> 90 -> ABS, chamber 40 C;
     > 65 -> PETG, chamber 30 C), so at 80 C the chamber soak stops at 30 C.  With the fan
     at 50-70 % expect more warping on large parts; raise the bed toward 95-100 C if
     corners lift.  See slicer_profiles/README.md.
     Install: copy into Cura's materials/ folder (or Preferences > Materials > Import). -->
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
  <metadata>
    <name>
      <brand>Creality</brand>
      <material>ABS</material>
      <color>Black</color>
      <label>Creality Hyper ABS Black (repo)</label>
    </name>
    <GUID>6fccc338-b7c5-45f6-bbaa-56bc8ac50148</GUID>
    <version>1</version>
    <color_code>#1c1c1c</color_code>
    <description>Creality Hyper Series ABS, Black. 1.75 mm, 30-300 mm/s, nozzle 230-270 C, bed 80-100 C. Starting at bed 80 C, part fan 50-70 %.</description>
    <adhesion_info>Bed 80 C (range 80-100). Raise the bed if corners lift; brim on large parts.</adhesion_info>
  </metadata>
  <properties>
    <density>1.08</density>
    <diameter>1.75</diameter>
    <weight>1000</weight>
  </properties>
  <settings>
    <setting key="print temperature">230</setting>
    <setting key="heated bed temperature">80</setting>
    <setting key="build volume temperature">50</setting>
    <setting key="standby temperature">150</setting>
    <setting key="print cooling">50</setting>
    <setting key="retraction amount">0.5</setting>
    <setting key="retraction speed">35</setting>
    <setting key="adhesion tendency">0</setting>
    <setting key="surface energy">100</setting>
    <cura:setting key="material_print_temperature_layer_0">235</cura:setting>
    <cura:setting key="material_bed_temperature_layer_0">80</cura:setting>
    <cura:setting key="material_flow">90.3</cura:setting>
    <cura:setting key="cool_fan_speed_min">50</cura:setting>
    <cura:setting key="cool_fan_speed_max">70</cura:setting>
    <cura:setting key="cool_min_layer_time_fan_speed_max">20</cura:setting>
    <cura:setting key="cool_min_layer_time">12</cura:setting>
    <cura:setting key="cool_min_speed">20</cura:setting>
    <cura:setting key="cool_fan_full_layer">3</cura:setting>
  </settings>
</fdmmaterial>
